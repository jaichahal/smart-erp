# smart-erp development environment for processes running ON THE MAC
# (go run ./cmd/api, `just test`, psql, mc). Same values as .env.dev.example
# with container service names replaced by localhost and the published host
# ports from docker-compose.yml. The compose stack must be up.
#   cp .env.dev.host.example ../../apps/api/.env.host   (or export with direnv)
#   set -a; source .env.dev.host.example; set +a; go test ./...

ERP_ENV=dev
ERP_HTTP_ADDR=:8080
ERP_DATABASE_URL=postgres://erp_app:erp_app@localhost:5432/erp?sslmode=disable
ERP_MIGRATOR_DATABASE_URL=postgres://erp_migrator:erp_migrator@localhost:5432/erp?sslmode=disable
ERP_ADMIN_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable
ERP_VALKEY_URL=redis://localhost:6379/0
ERP_S3_ENDPOINT=http://localhost:9000
ERP_S3_ACCESS_KEY=minioadmin
ERP_S3_SECRET_KEY=minioadmin
ERP_S3_BUCKET_FILES=erp-files
ERP_S3_BUCKET_BACKUPS=erp-backups
ERP_S3_BUCKET_ANCHORS=erp-anchors
ERP_OFFSITE_S3_ENDPOINT=http://localhost:9000
ERP_OFFSITE_S3_ACCESS_KEY=minioadmin
ERP_OFFSITE_S3_SECRET_KEY=minioadmin
ERP_OFFSITE_S3_BUCKET=offsite-sim
ERP_ZITADEL_URL=http://localhost:8081
# Read the PAT out of the named volume once:
#   docker compose cp zitadel:/zitadel-pat/api.pat ~/.smart-erp/api.pat
ERP_ZITADEL_PAT_FILE=${HOME}/.smart-erp/api.pat
# headless-shell publishes no host port by design; for host-side PDF tests
# either `docker compose port headless-shell 9222` after adding a port mapping
# in a local override, or run Chrome locally with --remote-debugging-port=9222.
ERP_CHROMIUM_URL=http://localhost:9222
ERP_SMTP_ADDR=localhost:1025
ERP_PUSH_MODE=sink
ERP_PUSH_SINK_URL=http://localhost:8090
ERP_OTLP_ENDPOINT=localhost:4317
ERP_LOG_LEVEL=debug
