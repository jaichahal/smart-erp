{
  "name": "main protection",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "~DEFAULT_BRANCH"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "required_linear_history"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 1,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": true,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true,
        "allowed_merge_methods": [
          "squash"
        ]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "lint (golangci-lint)"
          },
          {
            "context": "test (go test -race)"
          },
          {
            "context": "licence (go-licenses)"
          },
          {
            "context": "sbom (syft, spdx-json)"
          },
          {
            "context": "openapi lint (redocly)"
          },
          {
            "context": "event schema examples validate"
          },
          {
            "context": "openapi drift (go generate)"
          },
          {
            "context": "contract-first (contracts/ and apps/ never in one PR)"
          },
          {
            "context": "immutable-change (migrations need the label)"
          },
          {
            "context": "spec-traceability (R-IDs and 08 test IDs in PR body)"
          }
        ]
      }
    },
    {
      "type": "merge_queue",
      "parameters": {
        "merge_method": "SQUASH",
        "max_entries_to_build": 5,
        "min_entries_to_merge": 1,
        "max_entries_to_merge": 5,
        "min_entries_to_merge_wait_minutes": 5,
        "grouping_strategy": "ALLGREEN",
        "check_response_timeout_minutes": 60
      }
    }
  ]
}