# smart-erp development environment (containers on the Mac).
#   cp .env.dev.example .env && docker compose up -d
# Compose reads COMPOSE_* from this file; the Go binaries read ERP_* through
# env_file. Values here are dev-only defaults; nothing in this file is a secret.
# For running Go binaries and tests directly on the host, see .env.dev.host.example.

# --- compose -----------------------------------------------------------------
COMPOSE_PROJECT_NAME=smart-erp
COMPOSE_FILE=docker-compose.yml:compose.dev.yml
COMPOSE_PROFILES=dev
ERP_IMAGE_TAG=dev
# 0.0.0.0 so phones/simulators on the LAN can reach the api and zitadel.
ERP_BIND_ADDR=0.0.0.0

# --- infrastructure credentials (dev) ----------------------------------------
POSTGRES_PASSWORD=postgres
ERP_MIGRATOR_PASSWORD=erp_migrator
ERP_APP_PASSWORD=erp_app
ZITADEL_DB_PASSWORD=zitadel
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# Exactly 32 characters.
ZITADEL_MASTERKEY=MasterkeyNeedsToHave32Characters
ZITADEL_ADMIN_PASSWORD=Admin1234!
ZITADEL_ORG_NAME=dev
ZITADEL_EXTERNALDOMAIN=localhost
ZITADEL_EXTERNALPORT=8081
ZITADEL_EXTERNALSECURE=false
ZITADEL_LOG_LEVEL=info
# Object-lock default retention for erp-anchors and offsite-sim (prod: 7y).
ERP_ANCHOR_RETENTION=1d
ERP_EXTRA_BUCKETS=offsite-sim
ERP_PUBLIC_HOSTNAME=localhost
ERP_ACME_EMAIL=
ERP_OTLP_UPSTREAM=
ERP_OTLP_HEADER_AUTHORIZATION=

# --- Go services (read by api, worker, scheduler, migrate, pushsink) ----------
ERP_ENV=dev
ERP_HTTP_ADDR=:8080
ERP_DATABASE_URL=postgres://erp_app:erp_app@postgres:5432/erp?sslmode=disable
ERP_MIGRATOR_DATABASE_URL=postgres://erp_migrator:erp_migrator@postgres:5432/erp?sslmode=disable
ERP_ADMIN_DATABASE_URL=postgres://postgres:postgres@postgres:5432/postgres?sslmode=disable
ERP_VALKEY_URL=redis://valkey:6379/0
ERP_S3_ENDPOINT=http://minio:9000
ERP_S3_ACCESS_KEY=minioadmin
ERP_S3_SECRET_KEY=minioadmin
ERP_S3_BUCKET_FILES=erp-files
ERP_S3_BUCKET_BACKUPS=erp-backups
ERP_S3_BUCKET_ANCHORS=erp-anchors
# Dev simulates the off-site compliance bucket with a second local bucket.
ERP_OFFSITE_S3_ENDPOINT=http://minio:9000
ERP_OFFSITE_S3_ACCESS_KEY=minioadmin
ERP_OFFSITE_S3_SECRET_KEY=minioadmin
ERP_OFFSITE_S3_BUCKET=offsite-sim
ERP_ZITADEL_URL=http://zitadel:8080
ERP_ZITADEL_PAT_FILE=/zitadel-pat/api.pat
ERP_CHROMIUM_URL=http://headless-shell:9222
ERP_SMTP_ADDR=mailpit:1025
ERP_PUSH_MODE=sink
ERP_PUSH_SINK_URL=http://pushsink:8090
ERP_OTLP_ENDPOINT=otel-collector:4317
ERP_LOG_LEVEL=info
