# smart-erp production environment (Linux NUC, /opt/smart-erp/deploy/compose/.env)
#
# THIS FILE CONTAINS SECRETS ONCE FILLED IN. Never commit the real file. Keep
# it age-encrypted at /etc/smart-erp/env.age and let the operator key unlock it
# at boot (deploy/systemd/smart-erp.service, ExecStartPre). Mode 0600, owner root.
# Generate secrets with: openssl rand -base64 32 | tr -d '/+=' | cut -c1-32

# --- compose -----------------------------------------------------------------
COMPOSE_PROJECT_NAME=smart-erp
COMPOSE_FILE=docker-compose.yml:compose.prod.yml
COMPOSE_PROFILES=prod
# Pin to the release tag or digest CI published; rollback = previous value.
ERP_IMAGE_TAG=v0.1.0
# Loopback (or the NUC's Tailscale IP, e.g. 100.x.y.z) for postgres/valkey/
# minio/zitadel/api host ports. Only Caddy 80/443 face the network.
ERP_BIND_ADDR=127.0.0.1

# --- public ingress ----------------------------------------------------------
ERP_PUBLIC_HOSTNAME=erp.example.com
ERP_ACME_EMAIL=it@example.com

# --- infrastructure credentials ----------------------------------------------
POSTGRES_PASSWORD=CHANGE_ME
ERP_MIGRATOR_PASSWORD=CHANGE_ME
ERP_APP_PASSWORD=CHANGE_ME
ZITADEL_DB_PASSWORD=CHANGE_ME
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
# Exactly 32 characters. Losing it means losing every Zitadel secret.
ZITADEL_MASTERKEY=CHANGE_ME_EXACTLY_32_CHARACTERS_
ZITADEL_ADMIN_PASSWORD=CHANGE_ME
ZITADEL_ORG_NAME=Company
ZITADEL_LOG_LEVEL=warn
# Compliance-mode default retention on erp-anchors (set in compose.prod.yml).
ERP_ANCHOR_RETENTION=7y
ERP_EXTRA_BUCKETS=

# --- off-prem observability sink ---------------------------------------------
ERP_OTLP_UPSTREAM=otlp.example-observability.io:4317
ERP_OTLP_HEADER_AUTHORIZATION=Bearer CHANGE_ME

# --- Go services -------------------------------------------------------------
ERP_ENV=prod
ERP_HTTP_ADDR=:8080
ERP_DATABASE_URL=postgres://erp_app:CHANGE_ME@postgres:5432/erp?sslmode=disable
ERP_MIGRATOR_DATABASE_URL=postgres://erp_migrator:CHANGE_ME@postgres:5432/erp?sslmode=disable
ERP_ADMIN_DATABASE_URL=postgres://postgres:CHANGE_ME@postgres:5432/postgres?sslmode=disable
ERP_VALKEY_URL=redis://valkey:6379/0
ERP_S3_ENDPOINT=http://minio:9000
ERP_S3_ACCESS_KEY=CHANGE_ME
ERP_S3_SECRET_KEY=CHANGE_ME
ERP_S3_BUCKET_FILES=erp-files
ERP_S3_BUCKET_BACKUPS=erp-backups
ERP_S3_BUCKET_ANCHORS=erp-anchors
# Real off-site: cloud S3-compatible bucket with object lock, COMPLIANCE mode,
# least-privilege credentials (PutObject, GetObject, ListBucket; no delete).
ERP_OFFSITE_S3_ENDPOINT=https://s3.eu-central-1.example-cloud.com
ERP_OFFSITE_S3_ACCESS_KEY=CHANGE_ME
ERP_OFFSITE_S3_SECRET_KEY=CHANGE_ME
ERP_OFFSITE_S3_BUCKET=company-erp-offsite
ERP_ZITADEL_URL=http://zitadel:8080
ERP_ZITADEL_PAT_FILE=/zitadel-pat/api.pat
ERP_CHROMIUM_URL=http://headless-shell:9222
# Company mail relay (mailpit is dev-only).
ERP_SMTP_ADDR=smtp.example.com:587
# Real push in prod: fcm+apns credentials are provided by the notifications
# track's own ERP_FCM_* / ERP_APNS_* variables.
ERP_PUSH_MODE=live
ERP_PUSH_SINK_URL=
ERP_OTLP_ENDPOINT=otel-collector:4317
ERP_LOG_LEVEL=info
